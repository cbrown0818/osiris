# Copy to .env and replace every placeholder locally.
# Never commit the real .env file.

TZ=America/New_York
POSTGRES_USER=lilith_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=lilith
DATABASE_URL=postgresql://lilith_user:replace-with-a-strong-random-password@postgres:5432/lilith
QDRANT__SERVICE__API_KEY=replace-with-a-strong-random-key
OSIRIS_API_TOKEN=replace-with-a-strong-random-token
